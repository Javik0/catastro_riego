rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir lectura pública de las fotos de evidencia y escritura solo a usuarios autenticados
    match /fotos_predios/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
