# ─── Dependencias ────────────────────────────────────────────
node_modules/

# ─── Build output ────────────────────────────────────────────
dist/
dist-ssr/

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Variables de entorno (credenciales) ─────────────────────
.env
.env.local
.env.*.local
.env.production

# ─── Firebase emulators ──────────────────────────────────────
.firebase/
firebase-debug.log

# ─── GeoPackages (datos crudos — NO van en git, son grandes) ─
*.gpkg
*.db
*.sqlite

# ─── Datos de QField (se regeneran con sync_to_firestore.py) ─
# Los archivos GeoJSON en public/geo SÍ van en git (son pequeños)
# y sirven como snapshot del último sync.

# ─── Fotos del campo (van en Firebase Storage, no en git) ─────
public/DCIM/
*.jpg
*.jpeg
*.png
!public/logo-izq.png
!public/logo-der.png
!public/favicon.svg
!public/icons.svg

# ─── Editor ──────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ─── OS ──────────────────────────────────────────────────────
desktop.ini
*.local

# ─── Archivos temporales de MS Office (bloqueo mientras está abierto) ─
~$*

# ─── Entrega cartográfica al contratante ──────────────────────
# Se regenera con scripts/generar_gpkg_cliente.py y
# scripts/generar_proyecto_qgis_cliente.py. Son binarios derivados de
# public/geo, así que no se versionan: se generan antes de desplegar.
public/descargas/
build_entrega/

# ─── Python cache ────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
scripts/__pycache__/

# ─── Claves privadas y logs de sincronización locales ─────────
firebase-key.json
scripts/photos_sync_log.json

# Mapas intermedios del informe del sociólogo: los regenera
# generar_informe_sociologo.py y ya van embebidos en el HTML y el Word.
docs/mapas-sociologo/
