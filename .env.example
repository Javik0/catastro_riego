# Plantilla de las variables de desarrollo.
#
# Copiar como `.env.local` (ese sí lo ignora git) y ajustar. Ninguna de estas
# variables existe en producción: `npm run build` elimina el código que las lee.
#
#   cp .env.example .env.local
#
# Después de crearlo o cambiarlo, reiniciar `npm run dev`.

# Entrar sin pantalla de login al trabajar en local. Vacío o ausente = login normal.
VITE_DEV_LOGIN=1

# Rol de esa sesión simulada: admin | tecnico | cliente
# Cambiarlo es la forma de ver la aplicación como la ve cada rol; con `cliente`
# deben desaparecer Represa y Reportes.
VITE_DEV_ROL=admin
